# Environment - contains secrets, never commit
.env
.env.*
.setup-defaults.env
.setup-session.start
.htpasswd
nginx/auth/.htpasswd
setup/.wizard_url
setup/.ingest-check.json
setup/.database-check.json
deployment-urls.json
source.json

# Studies - generated at runtime, not source code
studies/

# Node
AWARE-Configurator/reactapp/node_modules/
AWARE-Configurator/reactapp/build/

# Python
__pycache__/
*.pyc
*.pyo

# Django
AWARE-Configurator/db.sqlite3
AWARE-Configurator/staticfiles/

# Docker runtime cache
aware-micro-server/cache/
backups/

# Compiled JAR - built inside Docker, no need to commit
aware-micro-server/output/*.jar

# Dot-folders - editor/IDE settings, tool caches, virtualenvs, AI assistant configs
.*/
# ...except CI config, which is source
!.github/

# macOS
.DS_Store

# Planning documents, not part of the software
docs/plans/

# Internal java version file
.java-version

# The broker's generated configuration: who may publish, who may only receive, and
# this deployment's own broker passwords.
mosquitto/mosquitto.conf
mosquitto/acl
mosquitto/passwords

# Generated from the database placement: present when the study names its own
# database, absent when this deployment runs one.
docker-compose.external-db.yml
